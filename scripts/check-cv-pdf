#!/bin/sh
# DESC: Check the generated CV PDF the way an applicant tracking system reads it

# POSIX sh rather than zsh: this runs in the GitHub Actions workflow and in the
# pre-commit hook, and ubuntu-latest has no zsh.

set -eu

script_dir=$(cd "$(dirname "$0")" && pwd)
root=$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null || dirname "$script_dir")

checker="$script_dir/ats-parse-check.py"
venv="$root/.venv-ats"

case "${1:-}" in
  -h|--help)
    cat <<'USAGE'
check-cv-pdf [PDF] [--json] [--quiet]

Runs the generated CV PDF through two text extractors with different
strategies (pdfminer.six, pypdf) and reports what each recovers: the
candidate name, employer names, date ranges, hyperlink annotations and
section headings. Expected values come from src/data/*.json.

  PDF        file to check (default: newest *_CV.pdf at the repo root)
  --json     machine-readable output
  --quiet    only warnings and failures

Exit 0 clean (warnings allowed) · 1 a check failed · 2 could not run.

The Python dependencies live in a repo-local venv at .venv-ats, created on
first run. Set CV_ATS_PYTHON to use your own interpreter instead.
USAGE
    exit 0
    ;;
esac

if [ -n "${CV_ATS_PYTHON:-}" ]; then
  python="$CV_ATS_PYTHON"
elif [ -x "$venv/bin/python" ]; then
  python="$venv/bin/python"
else
  echo "check-cv-pdf: creating $venv (first run)" >&2
  python3 -m venv "$venv" || { echo "check-cv-pdf: could not create venv" >&2; exit 2; }
  "$venv/bin/pip" install --quiet --disable-pip-version-check pypdf pdfminer.six pymupdf \
    || { echo "check-cv-pdf: could not install pypdf / pdfminer.six / pymupdf" >&2; exit 2; }
  python="$venv/bin/python"
fi

exec "$python" "$checker" "$@"
