# Production builds ship no source maps. They were 3.4 MB of a 4.7 MB deploy,
# main.js.map alone was 3.15 MB, and every deploy pushed them into the gh-pages
# branch's history. The source is public on this repo anyway, so a live map buys
# nothing a reader could not get from the source tree.
#
# `pnpm start` is unaffected: development builds still have full source maps.
# To read a production stack trace, build once with GENERATE_SOURCEMAP=true.
# scripts/bundle-attrib.py needs the maps, so build with them on before running it.
GENERATE_SOURCEMAP=false
